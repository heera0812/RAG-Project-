{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "main.py",
      "buildCommand": "pip install -r requirements.txt",
      "bindings": [
        {
          "type": "service",
          "service": "rag-for-beginners",
          "format": "url",
          "env": "RAG_BEGINNERS_URL"
        }
      ]
    },
    "rag-for-beginners": {
      "root": "rag-for-beginners",
      "framework": "fastapi",
      "entrypoint": "main.py",
      "buildCommand": "pip install -r requirements.txt"
    }
  },
  "rewrites": [
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "app"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
