# Shantikunj AI Environment Configuration
# Vector DB & Storage
CHROMA_PERSIST_DIR=./data/chroma
DATA_DIR=./data

# LLM & OCR API Configuration
# Option 1: OpenRouter (supports free models like qwen/qwen3.8-27b:free)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Option 2: Direct OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Model Selection
LLM_MODEL=qwen/qwen3.8-27b:free
OCR_MODEL=qwen/qwen3.8-27b:free
EMBEDDING_MODEL=all-MiniLM-L6-v2

# API Server Settings
PORT=8000
HOST=0.0.0.0
